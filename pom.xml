<?xml version="1.0" encoding="UTF-8"?>
<project root="true" xmlns="http://maven.apache.org/POM/4.1.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

	<modelVersion>4.1.0</modelVersion>

	<groupId>ch.unibas.medizin.universe.statemachine</groupId>
	<artifactId>universe-statemachine-parent</artifactId>
	<version>${revision}</version>
	<packaging>pom</packaging>

	<name>Universe Statemachine</name>
	<description>Common infrastructure to work with state machine concepts in Spring applications</description>
	<url>https://github.com/unibas-medfak/universe-statemachine</url>

	<organization>
		<name>Medical Faculty of Uni Basel</name>
		<url>https://medizin.unibas.ch</url>
	</organization>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Martin Imobersteg</name>
			<email>m.imobersteg@unibas.ch</email>
			<organization>Uni Basel</organization>
			<organizationUrl>https://medizin.unibas.ch</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git://github.com/unibas-medfak/universe-statemachine.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/unibas-medfak/universe-statemachine.git</developerConnection>
		<url>https://github.com/unibas-medfak/universe-statemachine</url>
	</scm>

	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/unibas-medfak/universe-statemachine/issues</url>
	</issueManagement>

	<subprojects>
		<subproject>universe-statemachine-core</subproject>
		<subproject>universe-statemachine-autoconfigure</subproject>
		<subproject>universe-statemachine-starter</subproject>
	</subprojects>

	<properties>
		<!-- Single source of truth for the project version (CI-friendly). -->
		<revision>1.0.0</revision>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.release>21</maven.compiler.release>

		<!-- Dependency versions. -->
		<spring-boot.version>4.1.1</spring-boot.version>
		<awaitility.version>4.3.0</awaitility.version>
		<blockhound.version>1.0.17.RELEASE</blockhound.version>
		<jsr305.version>3.0.2</jsr305.version>

		<!-- JUnit tags excluded by default. -->
		<excluded.test.groups>smoke</excluded.test.groups>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Spring Boot platform manages the bulk of the third-party versions. -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Internal modules. -->
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>universe-statemachine-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>universe-statemachine-autoconfigure</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Constraints not covered (or pinned tighter than) Spring Boot. -->
			<dependency>
				<groupId>com.google.code.findbugs</groupId>
				<artifactId>jsr305</artifactId>
				<version>${jsr305.version}</version>
			</dependency>
			<dependency>
				<groupId>org.awaitility</groupId>
				<artifactId>awaitility</artifactId>
				<version>${awaitility.version}</version>
			</dependency>
			<dependency>
				<groupId>io.projectreactor.tools</groupId>
				<artifactId>blockhound</artifactId>
				<version>${blockhound.version}</version>
			</dependency>
			<dependency>
				<groupId>io.projectreactor.tools</groupId>
				<artifactId>blockhound-junit-platform</artifactId>
				<version>${blockhound.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-clean-plugin</artifactId>
					<version>3.5.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.5.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.15.0</version>
					<configuration>
						<parameters>true</parameters>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.6</version>
					<configuration>
						<excludedGroups>${excluded.test.groups}</excludedGroups>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.5.1</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.4.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>3.12.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-gpg-plugin</artifactId>
					<version>3.2.8</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>build-helper-maven-plugin</artifactId>
					<version>3.6.1</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<profiles>
		<!-- Publishing concerns kept out of the default build so `mvn verify` stays
		     fast. Activate with `-Prelease`. -->
		<profile>
			<id>release</id>
			<properties>
				<!-- Publishing goes through the Central Portal, not deploy:deploy. -->
				<maven.deploy.skip>true</maven.deploy.skip>
			</properties>
			<build>
				<plugins>
					<!-- Replaces maven-deploy-plugin: uploads the bundle to the Central
					     Portal. Credentials come from the `central` server in settings.xml.
					     This is the community fork of org.sonatype.central's plugin; the
					     upstream 0.11.0 publishes Maven 4's build POM instead of the
					     consumer POM, which the Portal cannot parse. -->
					<plugin>
						<groupId>io.github.mavenplugins</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>1.3.1</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<!-- Upload and validate only; publishing is confirmed by hand in
							     the Central Portal. Set to true to release automatically. -->
							<autoPublish>false</autoPublish>
						</configuration>
						<!-- Bound by hand: under Maven 4 the plugin's extension suppresses
						     deploy:deploy but does not bind publish, so `deploy` would
						     otherwise succeed without uploading anything. -->
						<executions>
							<execution>
								<id>publish-to-central</id>
								<phase>deploy</phase>
								<goals>
									<goal>publish</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals><goal>jar-no-fork</goal></goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<configuration>
							<doclint>none</doclint>
							<quiet>true</quiet>
							<source>21</source>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals><goal>jar</goal></goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
								<configuration>
									<keyname>1411A464E5F9C9C5</keyname>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
